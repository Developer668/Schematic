      "files": [
        {
          "name": "sketch.ino",
          "content": "#include <Wire.h>\n#include <Adafruit_BMP280.h>\n#include <Adafruit_SSD1306.h>\nAdafruit_BMP280 bmp;\nAdafruit_SSD1306 oled(128,64,&Wire,-1);\nvoid setup(){ Wire.begin(); Serial.begin(115200); bmp.begin(0x76); oled.begin(SSD1306_SWITCHCAPVCC,0x3C); pinMode(18, OUTPUT); }\nvoid loop(){ float t=bmp.readTemperature(); oled.clearDisplay(); oled.setCursor(0,0); oled.print(\"Temp: \"); oled.print(t); oled.display(); if(t>30) digitalWrite(18,HIGH); else digitalWrite(18,LOW); delay(1000); }"
        }
      ]
    }
