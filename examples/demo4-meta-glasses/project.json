      "files": [
        {
          "name": "smart_glasses.ino",
          "content": "#include <Wire.h>\n\n// Meta-style audio-first glasses prototype\nconstexpr int CAPTURE_BUTTON = 4;\nconstexpr int AUDIO_OUT = 19;\nconstexpr int STATUS_LED = 18;\n\nvoid setup() {\n  pinMode(CAPTURE_BUTTON, INPUT_PULLUP);\n  pinMode(AUDIO_OUT, OUTPUT);\n  pinMode(STATUS_LED, OUTPUT);\n  Wire.begin(); // MPU6050 head-motion bus\n}\n\nvoid loop() {\n  const bool capture = digitalRead(CAPTURE_BUTTON) == LOW;\n  digitalWrite(STATUS_LED, capture);\n  if (capture) tone(AUDIO_OUT, 880, 80);\n  delay(20);\n}\n"
        }
      ]
    }
