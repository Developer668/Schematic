# Safe template only. Never commit a real value and never expose this through
# a VITE_* variable or client-side code.

# Required for a hosted Site session issuer. Use at least 32 random characters.
SCHEMATIC_SESSION_SECRET=replace-with-at-least-32-random-characters

# Site identity/session defaults. Keep platform identity verification enabled.
SCHEMATIC_AUTH_MODE=chatgpt-sites
SCHEMATIC_TRUST_PLATFORM_HEADERS=true
SCHEMATIC_SESSION_TTL_SECONDS=3600

# Leave both unset for the canonical same-origin Site API. A remote origin is
# an explicit local/integration-test override, never an implicit fallback.
# VITE_BACKEND_URL=
# SCHEMATIC_API_ORIGIN=

# Optional server-side parts provider adapters. These values are read only by
# the same-origin API; never prefix secrets with VITE_ and never put provider
# tokens in frontend code. Each adapter must accept either GET query params
# (?query, quantity, limit) or a POST JSON body with {query, quantity, limit},
# and return {results: [{catalogId, title, partNumber, exactMatch, offers: [{
# retailer, title, price, currency, url}]}]}. Schematic never guesses a
# catalogId from a title or part number and never publishes these candidates
# directly; the authenticated WebMCP agent verifies and calls shopping.search.
PARTS_PROVIDER_ORDER=mouser,digikey,element14,adafruit
PARTS_PROVIDER_MAX_ATTEMPTS=4
PARTS_PROVIDER_CACHE_TTL_SECONDS=45
# JSON is useful when provider adapters need different endpoints or headers:
# PARTS_PROVIDER_ENDPOINTS=[{"id":"mouser","label":"Mouser","endpoint":"https://adapter.example/mouser","method":"POST","tokenEnv":"MOUSER_API_KEY","tokenHeader":"x-api-key"}]
# Shorthand per-provider configuration is also supported:
# PARTS_PROVIDER_MOUSER_URL=https://adapter.example/mouser
# PARTS_PROVIDER_MOUSER_METHOD=POST
# PARTS_PROVIDER_MOUSER_TOKEN_ENV=MOUSER_API_KEY
# MOUSER_API_KEY=replace-with-a-server-only-secret
