# Safe template only. Never commit a real value and never expose this through
# a VITE_* variable or client-side code.

# Required for a hosted Site session issuer. Use at least 32 random characters.
SCHEMATIC_SESSION_SECRET=replace-with-at-least-32-random-characters

# Site identity/session defaults. Keep platform identity verification enabled.
SCHEMATIC_AUTH_MODE=chatgpt-sites
SCHEMATIC_TRUST_PLATFORM_HEADERS=true
SCHEMATIC_SESSION_TTL_SECONDS=3600

# Leave both unset for the canonical same-origin Site API. A remote origin is
# an explicit local/integration-test override, never an implicit fallback.
# VITE_BACKEND_URL=
# SCHEMATIC_API_ORIGIN=

# Keyless public discovery is the canonical path. It uses bounded JLCSearch
# JSON discovery and exact-product Adafruit lookup without provider accounts or
# secrets. Results are candidates only; the authenticated WebMCP agent must
# verify the canonical part and publish current HTTPS offers.
PARTS_PUBLIC_SOURCES_ENABLED=true

# Bright Data Google Shopping discovery is server-only and uses a bounded
# cache plus per-user and per-runtime limits. Binding BRIGHTDATA_API_KEY enables
# it by default; BRIGHTDATA_SERP_ENABLED=false explicitly disables it. Set the
# real key only in the hosted Site environment; never prefix it with VITE_ or
# commit it here.
# BRIGHTDATA_SERP_ENABLED=true
# BRIGHTDATA_API_KEY=replace-with-a-server-only-secret
# BRIGHTDATA_SERP_ZONE=serp_api1
# BRIGHTDATA_SERP_COUNTRY=us
# BRIGHTDATA_SERP_LANGUAGE=en
# BRIGHTDATA_SERP_CURRENCY=USD
# BRIGHTDATA_SERP_TIMEOUT_SECONDS=20
# BRIGHTDATA_SERP_CACHE_TTL_SECONDS=900
# BRIGHTDATA_SERP_EMPTY_CACHE_TTL_SECONDS=300
# BRIGHTDATA_MAX_REQUESTS_PER_HOUR=10
# BRIGHTDATA_MAX_REQUESTS_PER_DAY=40
# BRIGHTDATA_MAX_GLOBAL_REQUESTS_PER_DAY=200

# Generic paid provider adapters are intentionally disabled by default.
# PARTS_PAID_PROVIDERS_ENABLED=false
# PARTS_PROVIDER_ORDER=mouser,digikey,element14,adafruit
# PARTS_PROVIDER_MAX_ATTEMPTS=4
# PARTS_PROVIDER_CACHE_TTL_SECONDS=45
# PARTS_PROVIDER_ENDPOINTS=[{"id":"mouser","label":"Mouser","endpoint":"https://adapter.example/mouser","method":"POST","tokenEnv":"MOUSER_API_KEY","tokenHeader":"x-api-key"}]
# PARTS_PROVIDER_MOUSER_URL=https://adapter.example/mouser
# PARTS_PROVIDER_MOUSER_METHOD=POST
# PARTS_PROVIDER_MOUSER_TOKEN_ENV=MOUSER_API_KEY
# MOUSER_API_KEY=replace-with-a-server-only-secret
