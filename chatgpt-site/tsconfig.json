{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["node", "@cloudflare/workers-types"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@schematic/hardware-graph": ["../packages/hardware-graph/src"],
      "@schematic/validation": ["../packages/validation/src"],
      "@schematic/component-format": ["../packages/component-format/src"],
      "@schematic/session": ["../functions/_auth.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "../frontend/src/vite-env.d.ts"],
  "exclude": ["node_modules"]
}
