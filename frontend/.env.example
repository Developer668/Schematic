# Copy to frontend/.env (gitignored) and fill in the values you want in the
# local build. Client VITE_* values ship in the bundle; they identify the
# project but are not secrets. Server secrets live in the Cloudflare Pages
# project settings (and chatgpt-site hosting env), never here.

# --- Firebase (client; paste from Firebase console → Project settings) ---
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# --- Sign in with ChatGPT on Cloudflare Pages (client; from OAuth app) ---
# VITE_CHATGPT_OAUTH_AUTHORIZE_URL=https://provider.example/authorize
# VITE_CHATGPT_OAUTH_CLIENT_ID=
# VITE_CHATGPT_OAUTH_SCOPE=openid email profile

# --- Optional: pin the default sign-in mode ("firebase" or "chatgpt-oauth") ---
# VITE_AUTH_MODE=
