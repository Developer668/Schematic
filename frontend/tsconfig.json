{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@schematic/hardware-graph": ["../packages/hardware-graph/src"],
      "@schematic/validation": ["../packages/validation/src"],
      "@schematic/component-format": ["../packages/component-format/src"],
      "@schematic/firmware-harness": ["../packages/firmware-harness/src/index.ts"],
      "@schematic/project-storage": ["../packages/project-storage/src/index.ts"]
    }
  },
  "include": ["src"]
}
